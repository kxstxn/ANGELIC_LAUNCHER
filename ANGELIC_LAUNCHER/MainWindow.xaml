<Window x:Class="ANGELIC_LAUNCHER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ANGELIC_LAUNCHER"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Angelic Launcher" Height="468" Width="675"
        Foreground="White">

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/image/background.jpg"/>
    </Window.Background>

    <Grid Margin="0,0,0,-6">
        <Frame Content="Frame" Background="Black" NavigationUIVisibility="Automatic" Margin="0,271,0,0" Opacity="0.5"/>
        <ui:Button x:Name="StartButton" Appearance="Primary" Content="Play" Margin="491,370,0,0" VerticalAlignment="Top" Width="154" Click="StartButton_Click" Height="40" Background="HotPink" FontFamily="Arial Black" Cursor="Hand" FontSize="20" Foreground="White" PressedForeground="Black">
            <ui:Button.Effect>
                <DropShadowEffect Color="HotPink" ShadowDepth="2" BlurRadius="1"/>
            </ui:Button.Effect>
        </ui:Button>
        <ComboBox x:Name="VersionsCombobox" HorizontalAlignment="Left" Margin="172,330,0,0" VerticalAlignment="Top" Width="138" Height="30" FontSize="10"/>
        <Label Content="Select Version" HorizontalAlignment="Left" Margin="172,307,0,0" VerticalAlignment="Top" Width="121" RenderTransformOrigin="3.815,0.51"/>
        <ProgressBar x:Name="DownloadProgressBar" HorizontalAlignment="Left" Height="40" Margin="21,370,0,0" VerticalAlignment="Top" Width="456"/>
        <ui:TextBox x:Name="NicknameTextBox" PlaceholderText="Enter Nickname" HorizontalAlignment="Left" Margin="21,330,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139" Height="30" FontSize="10"/>
        <Label Content="Nickname" HorizontalAlignment="Left" Margin="21,307,0,0" VerticalAlignment="Top" Width="121" RenderTransformOrigin="3.815,0.51"/>
        <Label x:Name="PercentLabel" Content="    " HorizontalAlignment="Left" Margin="34,380,0,0" VerticalAlignment="Top"/>
        <ui:TextBox x:Name="DefaultServerTextBox" HorizontalAlignment="Left" Margin="323,330,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="154" Height="30" PlaceholderText="Enter default server" FontSize="10"/>
        <Label Content="Default Server" HorizontalAlignment="Left" Margin="323,307,0,0" VerticalAlignment="Top" Width="121" RenderTransformOrigin="3.815,0.51"/>



    </Grid>
</Window>
